{
  "name": "vora-frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @vora/mobile run start",
    "mobile:android": "npm --workspace @vora/mobile run android",
    "mobile:web": "npm --workspace @vora/mobile run web",
    "export:web": "npm --workspace @vora/mobile run export:web",
    "typecheck": "npm --workspace @vora/mobile run typecheck"
  }
}
